# ==============================================================================
# SmartExpense - Environment Variables Template
# ==============================================================================
# HƯỚNG DẪN:
# Sao chép file này thành .env trước khi chạy Docker Compose:
#   cp .env.example .env (Linux/macOS) hoặc Copy-Item .env.example .env (PowerShell)
# Thay đổi các giá trị mật khẩu và khóa bảo mật phù hợp với môi trường của bạn.
# TUYỆT ĐỐI KHÔNG commit file .env chứa thông tin thật lên Git!
# ==============================================================================

# Database Configuration
DB_NAME=personal_finance_db
# Backend chạy trực tiếp dùng URL này; Compose tự dùng mysql:3306 theo DB_NAME.
DB_URL=jdbc:mysql://localhost:3306/personal_finance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
# Placeholder để trống: bắt buộc điền trước khi chạy; với user root, hai mật khẩu phải giống nhau.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Chỉ dùng cho override local trong README; compose.yaml mặc định không publish MySQL.
DB_PORT=3307
DB_BIND=127.0.0.1

# JWT Security
# Placeholder để trống: điền Base64 của ít nhất 32 byte ngẫu nhiên, không dùng khóa mẫu chung.
JWT_SECRET=
JWT_EXPIRATION=86400

# D12 SMTP: credential để trống; không đưa App Password vào Git hoặc chat.
# Gmail STARTTLS: operator cấu hình SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME/SMTP_FROM là địa chỉ gửi được duyệt; App Password lấy qua secret của môi trường.
# Thiếu SMTP thì Auth khác vẫn khởi động; chưa thể xác nhận Email Live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_FRONTEND_URL=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Application Port & Binding
FRONTEND_PORT=8088
# FRONTEND_BIND: 127.0.0.1 (an toàn khi chạy sau Nginx host trên VPS) hoặc 0.0.0.0 (chạy độc lập)
FRONTEND_BIND=127.0.0.1

# Docker Images (Mặc định build local hoặc tải từ GitHub Container Registry - GHCR)
BACKEND_IMAGE=smartexpense-backend:latest
FRONTEND_IMAGE=smartexpense-frontend:latest
