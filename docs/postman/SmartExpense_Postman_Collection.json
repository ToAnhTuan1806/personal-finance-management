{
  "info": {
    "name": "SmartExpense API - MVP",
    "description": "Collection cho SmartExpense (ReactJS + Spring Boot + MySQL). QUY TRÌNH: Register (nếu chưa có) -> Login -> tạo 2 categories -> tạo 2 transactions -> kiểm thử Budgets + Dashboard -> thực hiện cleanup. Các request có thể tạo dữ liệu thật trong DB local. Không chạy cleanup nếu muốn giữ dữ liệu mẫu. Đổi demoEmail nếu dùng lại tài khoản đã tồn tại với mật khẩu khác. JWT lưu ở Collection Variables, không chia sẻ giá trị token thật.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "demoEmail",
      "value": "postman.demo@smartexpense.local"
    },
    {
      "key": "demoPassword",
      "value": "Demo@123456"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "expenseCategoryId",
      "value": ""
    },
    {
      "key": "incomeCategoryId",
      "value": ""
    },
    {
      "key": "expenseTransactionId",
      "value": ""
    },
    {
      "key": "incomeTransactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Auth & User",
      "description": "Đăng ký, đăng nhập và kiểm tra bảo vệ API. Chạy request Đăng nhập trước các nhóm còn lại.",
      "item": [
        {
          "name": "01 Đăng ký tài khoản demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Chạy được nhiều lần: lần sau có thể trả 409 vì email đã tồn tại. Nếu email đã tồn tại với mật khẩu khác, đổi demoEmail.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van Demo\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng ký thành công hoặc email đã tồn tại\", () => pm.expect([201,409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) { const data=pm.response.json(); pm.collectionVariables.set(\"userId\",String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Đăng nhập - tự lưu accessToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Đăng nhập HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Có accessToken\", () => pm.expect(data.accessToken).to.be.a('string').and.not.empty);",
                  "  pm.collectionVariables.set(\"accessToken\",data.accessToken);",
                  "  if(data.user && data.user.id) pm.collectionVariables.set(\"userId\",String(data.user.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Hồ sơ hiện tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.test(\"Không lộ passwordHash\", () => pm.expect(pm.response.text()).not.to.include(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sai mật khẩu → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"WrongPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Thiếu JWT → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
